# Local runtime data must never be baked into an image. These can hold real
# visitor messages (the SQLite database), session data, and logs. The
# placeholder .gitignore files are kept so the directories still exist.
database/*.sqlite
database/*.sqlite-*
storage/logs/*.log
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
!storage/framework/cache/data/.gitignore
!storage/framework/sessions/.gitignore
!storage/framework/views/.gitignore
.phpunit.cache
.phpunit.result.cache
